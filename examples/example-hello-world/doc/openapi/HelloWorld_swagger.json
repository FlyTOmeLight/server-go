        "helloworldv1.UpdateModuleRequest": {
            "type": "object",
            "required": [
                "id"
            ],
            "properties": {
                "description": {
                    "description": "描述",
                    "type": "string",
                    "maxLength": 200,
                    "x-nullable": true,
                    "example": "this is a description"
                },
                "id": {
                    "type": "string",
                    "maxLength": 20,
                    "example": "id1"
                }
            }
