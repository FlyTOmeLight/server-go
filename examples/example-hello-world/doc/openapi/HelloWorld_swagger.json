                },
                "description": {
                    "description": "描述",
                    "type": "string",
                    "example": "this is a description"
                },
                "id": {
                    "description": "ID,唯一标识",
                    "type": "string",
                    "example": "id1"
                },
                "name": {
                    "description": "名称",
                    "type": "string",
                    "example": "name-1"
                },
                "projectID": {
                    "description": "项目ID",
                    "type": "string",
                    "example": "project1"
