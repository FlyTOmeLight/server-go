        "helloworldv1.ListModuleRequest": {
            "type": "object",
            "properties": {
                "filter": {
                    "description": "搜索内容",
                    "type": "string",
                    "maxLength": 100,
                    "example": "name-1"
                },
                "order": {
                    "description": "排序规则: asc: 升序, desc: 倒序, 默认倒序\n\nExample: desc",
                    "type": "string",
                    "default": "desc",
                    "enum": [
                        "asc",
                        "desc"
                    ]
                },
                "orderBy": {
                    "description": "排序依据\n\nExample: name",
                    "type": "string"
                },
                "orders": {
                    "description": "mongo 排序规则\n\nExample: []string{ \"{order: desc}\", \"{id:asc}\" }",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "[{create_ad:desc}",
                        "{id:asc}]"
                    ]
                },
                "pageNo": {
                    "description": "页码\n\nExample: 1",
                    "type": "integer",
                    "default": 1,
                    "minimum": 0
                },
                "pageSize": {
                    "description": "每页的大小\n\nExample: 10",
                    "type": "integer",
                    "default": 20,
                    "maximum": 200,
                    "minimum": 0
                },
                "projectID": {
                    "description": "项目ID",
                    "type": "string",
                    "maxLength": 20,
                    "example": "project1"
                }
            }
