        "/v1/ListModule": {
            "post": {
                "description": "按项目和关键词筛选模块并返回总数与当前页。默认 pageNo=1、pageSize=20，pageSize 最大为 200；query 分页参数覆盖请求体中的同名字段。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Module"
                ],
                "summary": "获取示例模块列表",
                "operationId": "ListModule",
                "parameters": [
                    {
                        "description": "JSON 请求",
                        "name": "request",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/helloworldv1.ListModuleRequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "可选幂等标识；有已验证身份时，同一路由及相同参数重放已成功响应",
                        "name": "clientToken",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "default": 1,
                        "description": "页码；0 使用默认页码",
                        "name": "pageNo",
                        "in": "query"
                    },
                    {
                        "maximum": 200,
                        "minimum": 0,
                        "type": "integer",
                        "default": 20,
                        "description": "每页条数；0 使用默认大小",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "type": "string",
                        "default": "desc",
                        "description": "排序方向",
                        "name": "order",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "排序字段",
                        "name": "orderBy",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "模块列表与总数",
                        "schema": {
                            "$ref": "#/definitions/helloworldv1.ListModuleResponse"
                        }
                    },
                    "400": {
                        "description": "JSON 或请求参数不符合契约",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "408": {
                        "description": "等待幂等请求时取消或超时",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "409": {
                        "description": "同一幂等标识的请求参数不同",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "413": {
