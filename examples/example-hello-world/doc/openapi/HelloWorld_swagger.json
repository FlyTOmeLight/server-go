    "definitions": {
        "errors.Error": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "Code 错误码",
                    "type": "string"
                },
                "message": {
                    "description": "Message 详细错误信息",
                    "type": "string"
                },
                "requestId": {
                    "description": "RequestID 请求id，接收到请求的时候由中间件自动注入",
                    "type": "string"
                },
                "statusCode": {
                    "description": "StatusCode 状态码，推荐6位数字",
                    "type": "integer"
                }
            }
        },
        "helloworldv1.CreateModuleRequest": {
            "type": "object",
            "required": [
                "name",
                "projectID"
            ],
            "properties": {
                "description": {
                    "description": "描述",
                    "type": "string",
                    "maxLength": 200
                },
                "name": {
                    "description": "名称",
                    "type": "string",
                    "maxLength": 32,
                    "example": "name-1"
                },
                "projectID": {
                    "description": "项目ID",
                    "type": "string",
                    "maxLength": 20,
                    "example": "project1"
                }
            }
        },
        "helloworldv1.CreateModuleResponse": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "description": "创建时间",
                    "type": "string"
                },
                "description": {
                    "description": "描述",
                    "type": "string",
                    "example": "this is a description"
                },
                "id": {
                    "description": "ID,唯一标识",
                    "type": "string",
                    "example": "id1"
                },
                "name": {
                    "description": "名称",
                    "type": "string",
                    "example": "name-1"
                },
                "projectID": {
                    "description": "项目ID",
                    "type": "string",
                    "example": "project1"
                },
                "updatedAt": {
                    "description": "更新时间",
                    "type": "string"
                },
                "userID": {
                    "description": "用户ID",
                    "type": "string",
                    "example": "user1"
                }
            }
        },
