{
    "swagger": "2.0",
    "info": {
        "description": "Note CRUD with PostgreSQL persistence and typed request validation.",
        "title": "PostgreSQL Notes OpenAPI",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/v1/notes": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Notes"
                ],
                "summary": "List notes",
                "parameters": [
                    {
                        "maximum": 1000000,
                        "minimum": 1,
                        "type": "integer",
                        "default": 1,
                        "description": "Page number",
                        "name": "pageNo",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 20,
                        "description": "Notes per page",
                        "name": "pageSize",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Notes and total count",
                        "schema": {
                            "$ref": "#/definitions/notev1.ListNotesResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid pagination",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "500": {
                        "description": "Storage or initialization failure",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    }
                }
            },
            "post": {
                "description": "Name is required and at most 64 characters; description is at most 1024 characters and priority is 0..10. Omitted priority defaults to 2 and enabled to true. Explicit null for either field is invalid; reviewed may be null.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Notes"
                ],
                "summary": "Create a note",
                "parameters": [
                    {
                        "description": "Note payload; name is required",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/notev1.CreateNoteRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created note",
                        "schema": {
                            "$ref": "#/definitions/notev1.Note"
                        }
                    },
                    "400": {
                        "description": "Invalid payload",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "413": {
                        "description": "JSON body exceeds 1 MiB",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "500": {
                        "description": "Storage or initialization failure",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    }
                }
            }
        },
        "/v1/notes/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Notes"
                ],
                "summary": "Get a note",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Note UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Stored note",
                        "schema": {
                            "$ref": "#/definitions/notev1.Note"
                        }
                    },
                    "400": {
                        "description": "Invalid note ID",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "404": {
                        "description": "Note not found",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "500": {
                        "description": "Storage failure",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    }
                }
            },
            "put": {
                "description": "PUT replaces name, description, priority, enabled and reviewed. Name is required and at most 64 characters; description is at most 1024 characters and priority is 0..10. Omitted priority defaults to 2, enabled to true, and reviewed to null; explicit null for priority or enabled is invalid.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Notes"
                ],
                "summary": "Replace a note",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Note UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Complete replacement payload; ID comes from the path",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/notev1.UpdateNoteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Updated note",
                        "schema": {
                            "$ref": "#/definitions/notev1.Note"
                        }
                    },
                    "400": {
                        "description": "Invalid ID or payload",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "404": {
                        "description": "Note not found",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "413": {
                        "description": "JSON body exceeds 1 MiB",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "500": {
                        "description": "Storage or initialization failure",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    }
                }
            },
            "delete": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Notes"
                ],
                "summary": "Delete a note",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Note UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Note deleted; response has no body"
                    },
                    "400": {
                        "description": "Invalid note ID",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "404": {
                        "description": "Note not found",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    },
                    "500": {
                        "description": "Storage failure",
                        "schema": {
                            "$ref": "#/definitions/errors.Error"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "errors.Error": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "Code 错误码",
                    "type": "string"
                },
                "message": {
                    "description": "Message 详细错误信息",
                    "type": "string"
                },
                "requestId": {
                    "description": "RequestID 请求id，接收到请求的时候由中间件自动注入",
                    "type": "string"
                },
                "statusCode": {
                    "description": "StatusCode 状态码，推荐6位数字",
                    "type": "integer"
                }
            }
        },
        "notev1.CreateNoteRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "maxLength": 1024
                },
                "enabled": {
                    "type": "boolean",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "maxLength": 64
                },
                "priority": {
                    "type": "integer",
                    "default": 2,
                    "maximum": 10,
                    "minimum": 0
                },
                "reviewed": {
                    "type": "boolean",
                    "x-nullable": true
                }
            }
        },
        "notev1.ListNotesResponse": {
            "type": "object",
            "properties": {
                "pageNo": {
                    "type": "integer"
                },
                "pageSize": {
                    "type": "integer"
                },
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/notev1.Note"
                    }
                },
                "totalCount": {
                    "type": "integer"
                }
            }
        },
        "notev1.Note": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "priority": {
                    "type": "integer"
                },
                "reviewed": {
                    "type": "boolean",
                    "x-nullable": true
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "notev1.UpdateNoteRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "maxLength": 1024
                },
                "enabled": {
                    "type": "boolean",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "maxLength": 64
                },
                "priority": {
                    "type": "integer",
                    "default": 2,
                    "maximum": 10,
                    "minimum": 0
                },
                "reviewed": {
                    "type": "boolean",
                    "x-nullable": true
                }
            }
        }
    }
}
